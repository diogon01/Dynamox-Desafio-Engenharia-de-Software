{
  "name": "dynamox-challenge",
  "version": "0.1.0",
  "private": true,
  "description": "Desafio Full-Stack Dynamox — monorepo Nx com API NestJS, frontend React e telemetria de séries temporais",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "contracts:validate": "tsx tools/validate-contracts.ts",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "dev:api": "npm run dev -w @dynamox/api",
    "dev:web": "npm run dev -w @dynamox/web",
    "analysis:inventory": "tsx tools/extract-endpoint-inventory.ts",
    "perf:latency": "tsx tools/measure-latency.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "nx": "^20.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "prisma": "^5.22.0"
  }
}
